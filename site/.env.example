# Web3Forms access key — submissions from the Start Your Project form are
# emailed to the address this key was created for. Get one free at
# https://web3forms.com. Leave empty during development to use the mock handler.
VITE_WEB3FORMS_KEY=

# Shown to visitors in the footer, FAQ, and as a fallback if submission fails.
VITE_CONTACT_EMAIL=hello@femylabs.com
